# Optional. El Eco runs the sample ghost with none of these set.
# GitHub's anonymous limit is 60 requests an hour. A token raises it.
GITHUB_TOKEN=

# Local Gemma. Install Ollama, then: ollama pull gemma3
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Only used when someone presses "Send this eulogy to ElevenLabs".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Prior Labs token after you accept the TabPFN-3.5 non-commercial license.
# https://ux.priorlabs.ai
TABPFN_TOKEN=

# Opens the public GitHub page in a remote browser. The key is project-scoped.
BROWSERBASE_API_KEY=
